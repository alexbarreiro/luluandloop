{
  "expo": {
    "name": "Lulu & Loop",
    "slug": "luluandloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luluandloop.app"
    },
    "android": {
      "package": "com.luluandloop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFF8F0",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "scheme": "luluandloop"
  }
}